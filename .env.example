# Copy to .env for local use, or set these in the backend host's environment settings. Never commit real values.

# Login (two shared passwords) and cookie signing
SESSION_SECRET=
VIEWER_PASSWORD=
ADMIN_PASSWORD=

# Data sources
BITRIX_WEBHOOK_URL=
NOTION_TOKEN=
GOOGLE_SHEET_ID=
# Local: path to the key file. Hosted: paste the whole key JSON into GOOGLE_SERVICE_ACCOUNT_JSON instead.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional counting window
KPI_COUNT_FROM=
KPI_COUNT_TO=
BITRIX_MAX_CONCURRENT=

# Server. Local defaults need none of these.
PORT=3000
# Hosted only:
HOST=0.0.0.0
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
TRUST_PROXY=1
